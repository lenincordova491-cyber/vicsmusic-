{
  "schema": "vicsmusic-extension/1",
  "official": true,
  "id": "deezer-preview",
  "name": "Deezer (previews 30 s)",
  "version": "1.0.0",
  "lang": [
    "multi"
  ],
  "status": "verificar-endpoints",
  "legal": {
    "license": "Previews promocionales de Deezer",
    "notice": "Solo fragmentos de 30 segundos. Útil para descubrir y para metadatos y carátulas.",
    "docs": "https://developers.deezer.com/api"
  },
  "auth": {
    "type": "none"
  },
  "http": {
    "baseUrl": "https://api.deezer.com",
    "userAgent": "Vicsmusic/{{appVersion}}",
    "timeoutMs": 10000,
    "maxBytes": 2097152
  },
  "capabilities": [
    "SEARCH",
    "STREAM",
    "BROWSE"
  ],
  "paging": {
    "type": "offset",
    "pageSize": 25
  },
  "endpoints": {
    "searchTracks": {
      "method": "GET",
      "path": "/search",
      "query": {
        "q": "{{query}}",
        "limit": "{{limit}}",
        "index": "{{offset}}"
      },
      "response": {
        "itemsPath": "$.data",
        "map": {
          "id": "$.id",
          "title": "$.title",
          "artist": "$.artist.name",
          "album": "$.album.title",
          "durationMs": {
            "path": "$.duration",
            "mul": 1000
          },
          "artworkUrl": "$.album.cover_big",
          "streamUrl": "$.preview",
          "previewOnly": true
        }
      }
    },
    "home": {
      "method": "GET",
      "path": "/chart/0/tracks",
      "query": {
        "limit": "{{limit}}"
      },
      "sectionTitle": "Top global",
      "response": {
        "itemsPath": "$.data",
        "map": {
          "id": "$.id",
          "title": "$.title",
          "artist": "$.artist.name",
          "album": "$.album.title",
          "durationMs": {
            "path": "$.duration",
            "mul": 1000
          },
          "artworkUrl": "$.album.cover_big",
          "streamUrl": "$.preview",
          "previewOnly": true
        }
      }
    }
  }
}
