{
  "schema": "vicsmusic-extension/1",
  "official": true,
  "id": "internet-archive",
  "name": "Internet Archive (Audio)",
  "version": "1.0.0",
  "lang": [
    "multi"
  ],
  "status": "verificar-endpoints",
  "legal": {
    "license": "Dominio público / licencias abiertas (varía por ítem)",
    "notice": "Incluye grabaciones de dominio público y conciertos autorizados. Revisa la licencia de cada ítem.",
    "docs": "https://archive.org/developers/"
  },
  "auth": {
    "type": "none"
  },
  "http": {
    "baseUrl": "https://archive.org",
    "userAgent": "Vicsmusic/{{appVersion}}",
    "timeoutMs": 10000,
    "maxBytes": 2097152,
    "rateLimit": {
      "requests": 2,
      "perSeconds": 1
    }
  },
  "capabilities": [
    "SEARCH",
    "STREAM"
  ],
  "paging": {
    "type": "page",
    "pageSize": 25,
    "firstPage": 1
  },
  "endpoints": {
    "searchTracks": {
      "method": "GET",
      "path": "/advancedsearch.php",
      "query": {
        "q": "mediatype:audio AND title:({{query}})",
        "fl[]": [
          "identifier",
          "title",
          "creator"
        ],
        "rows": "{{limit}}",
        "page": "{{page}}",
        "output": "json"
      },
      "response": {
        "itemsPath": "$.response.docs",
        "map": {
          "id": "$.identifier",
          "title": "$.title",
          "artist": "$.creator",
          "artworkUrl": {
            "template": "https://archive.org/services/img/{{$.identifier}}"
          }
        }
      }
    },
    "resolveStream": {
      "method": "GET",
      "path": "/metadata/{{id}}",
      "select": {
        "itemsPath": "$.files",
        "whereFormatIn": [
          "VBR MP3",
          "MP3",
          "Ogg Vorbis"
        ],
        "pick": "first",
        "urlTemplate": "https://archive.org/download/{{id}}/{{$.name}}"
      }
    }
  }
}
