{
  "schema": "vicsmusic-extension/1",
  "official": true,
  "id": "itunes-preview",
  "name": "iTunes Search (previews 30 s)",
  "version": "1.0.0",
  "lang": [
    "multi"
  ],
  "status": "verificar-endpoints",
  "legal": {
    "license": "Previews promocionales de Apple",
    "notice": "Solo fragmentos de 30 segundos. Útil para descubrir y para metadatos y carátulas, no para escuchar completo.",
    "docs": "https://developer.apple.com/library/archive/documentation/AudioVideo/Conceptual/iTuneSearchAPI/"
  },
  "auth": {
    "type": "none"
  },
  "http": {
    "baseUrl": "https://itunes.apple.com",
    "userAgent": "Vicsmusic/{{appVersion}}",
    "timeoutMs": 10000,
    "maxBytes": 2097152
  },
  "capabilities": [
    "SEARCH",
    "STREAM"
  ],
  "paging": {
    "type": "offset",
    "pageSize": 25
  },
  "endpoints": {
    "searchTracks": {
      "method": "GET",
      "path": "/search",
      "query": {
        "term": "{{query}}",
        "media": "music",
        "entity": "song",
        "limit": "{{limit}}"
      },
      "response": {
        "itemsPath": "$.results",
        "map": {
          "id": "$.trackId",
          "title": "$.trackName",
          "artist": "$.artistName",
          "album": "$.collectionName",
          "durationMs": "$.trackTimeMillis",
          "artworkUrl": {
            "path": "$.artworkUrl100",
            "replace": [
              "100x100",
              "600x600"
            ]
          },
          "streamUrl": "$.previewUrl",
          "previewOnly": true
        }
      }
    }
  }
}
